# Copiar a .env, chmod 600, y rellenar. NUNCA commitear .env (SR03).

# IP LAN del appliance. Doble función (una sola fuente de verdad):
#  1. bind de los puertos publicados por Docker → evita exponerlos en las WAN (T5)
#  2. go2rtc.webrtc.candidates en config.yml → WebRTC ≤2 s en LAN y por WireGuard (RF04)
# Poner 0.0.0.0 SOLO si se decide confiar únicamente en las reglas DOCKER-USER (runbook §8).
FRIGATE_LAN_IP=192.168.1.1

# Cuenta de cámara creada en la app Tapo (misma en ambas o duplicar variables)
FRIGATE_RTSP_USER=camuser
FRIGATE_RTSP_PASSWORD=CAMBIAR

# Usuario "frigate" creado con mosquitto_passwd (Paso 5 del runbook)
FRIGATE_MQTT_PASSWORD=CAMBIAR
