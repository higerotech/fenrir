# Copiar a .env, chmod 600, y rellenar. NUNCA commitear .env (SR03).
#
# Este repositorio es publico: ninguna IP, MAC ni nombre real del despliegue vive en el.
# Los valores de abajo estan en 192.0.2.0/24, el rango que RFC 5737 reserva para
# documentacion, precisamente para que se vea a simple vista que son marcadores.

# IP LAN del appliance. Doble funcion (una sola fuente de verdad):
#  1. bind de los puertos publicados por Docker -> evita exponerlos en las WAN (T5)
#  2. go2rtc.webrtc.candidates en config.yml -> WebRTC <=2 s en LAN y por WireGuard (RF04)
# Poner 0.0.0.0 SOLO si se decide confiar unicamente en las reglas DOCKER-USER (runbook 8).
FRIGATE_LAN_IP=192.0.2.1

# IPs de las camaras, fijadas por reserva DHCP en dnsmasq (runbook Paso 1).
FRIGATE_CAM1_IP=192.0.2.61
FRIGATE_CAM2_IP=192.0.2.62

# Cuenta de camara creada en la app Tapo (misma en ambas o duplicar variables)
FRIGATE_RTSP_USER=camuser
FRIGATE_RTSP_PASSWORD=CAMBIAR

# Broker MQTT existente en el host (ADR-0008): nombre del contenedor en la red `iot`.
# El NVR no despliega broker propio.
FRIGATE_MQTT_HOST=<nombre-del-contenedor-mosquitto>
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=CAMBIAR

# Red Docker ya existente donde viven broker, Node-RED, Prometheus y Alertmanager.
IOT_NETWORK=<nombre-de-la-red>

# GID del grupo `render` del host, para que el contenedor pueda usar /dev/dri (VAAPI).
# Obtenerlo con: getent group render | cut -d: -f3
RENDER_GID=993
